# SafeVoice environment template
# Copy to .env.local and fill in real values. NEVER commit real secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application encryption (server only) ---
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- AI responder (Vercel AI Gateway) ---
AI_GATEWAY_API_KEY=
# Any AI Gateway model string, e.g. openai/gpt-4o-mini
AI_MODEL=openai/gpt-4o-mini

# --- Optional ---
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
